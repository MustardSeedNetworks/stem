{
  "name": "stem-ui",
  "version": "0.35.2",
  "private": true,
  "type": "module",
  "description": "The Stem WebUI - Network Performance Testing - Mustard Seed Networks",
  "engines": {
    "node": "26.13.1",
    "npm": "12.2.3"
  },
  "scripts": {
    "build": "tsc --build && node --disable-warning=DEP0205 ./node_modules/vite/bin/vite.js build",
    "build-storybook": "storybook build",
    "build:analyze": "tsc --build && ANALYZE=true node --disable-warning=DEP0205 ./node_modules/vite/bin/vite.js build",
    "dev": "node --disable-warning=DEP0205 ./node_modules/vite/bin/vite.js",
    "format": "biome format --write src/",
    "gen-types": "node scripts/gen-types.mjs",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "preview": "node --disable-warning=DEP0205 ./node_modules/vite/bin/vite.js preview",
    "storybook": "storybook dev -p 6006",
    "test": "node --disable-warning=DEP0205 ./node_modules/vitest/vitest.mjs run --reporter=verbose",
    "test:coverage": "node --disable-warning=DEP0205 ./node_modules/vitest/vitest.mjs run --coverage --reporter=verbose",
    "test:storybook": "npm run build-storybook && npm run test:storybook:run",
    "test:storybook:contract": "../scripts/test-storybook-contract.sh",
    "test:storybook:run": "node --disable-warning=DEP0205 ./node_modules/vitest/vitest.mjs run --config vitest.storybook.config.ts --project=storybook",
    "test:watch": "node --disable-warning=DEP0205 ./node_modules/vitest/vitest.mjs --reporter=dot",
    "typecheck": "tsc --build --noEmit"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": "biome check --write --no-errors-on-unmatched",
    "*.json": "biome format --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@hookform/resolvers": "6.0.2",
    "@tailwindcss/postcss": "4.3.5",
    "@tanstack/react-query": "5.108.1",
    "cmdk": "1.1.1",
    "i18next": "26.7.2",
    "i18next-browser-languagedetector": "8.3.1",
    "immer": "11.2.10",
    "lucide-react": "1.77.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-i18next": "17.1.13",
    "react-router": "8.5.2",
    "tailwind-merge": "3.7.1",
    "tailwindcss": "4.3.3",
    "valibot": "1.5.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@babel/core": "8.1.2",
    "@biomejs/biome": "2.6.4",
    "@chromatic-com/storybook": "5.6.0",
    "@playwright/test": "1.64.1",
    "@rolldown/plugin-babel": "0.3.1",
    "@storybook/addon-a11y": "10.6.8",
    "@storybook/addon-docs": "10.6.8",
    "@storybook/addon-onboarding": "10.6.8",
    "@storybook/addon-vitest": "10.6.8",
    "@storybook/react-vite": "10.6.8",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/babel__core": "7.20.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "axe-core": "4.14.1",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "30.1.3",
    "json-schema-to-typescript": "16.0.0",
    "playwright": "1.64.1",
    "postcss": "8.5.33",
    "rollup-plugin-visualizer": "7.1.3",
    "storybook": "10.6.8",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "js-yaml": "5.5.0",
    "nanoid": "6.0.2",
    "undici": "8.12.4"
  },
  "packageManager": "npm@12.2.3",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents": false
  }
}
