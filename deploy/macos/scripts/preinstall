#!/bin/bash
#
# Pre-install script for The Stem macOS .pkg
#
# Stops a running service before the binary is replaced. Nothing else is
# touched: stem.yaml, auth/, certs/, data/ and .daemon.json stay
# where they are.
#

set -e

log() {
    /usr/bin/logger -t "stem-installer" "$1"
    echo "$1"
}

log "Starting pre-install for The Stem..."

for label in com.stem com.stem.update; do
    launchctl bootout "system/$label" 2>/dev/null || true
done

# bootout returns before the daemon has exited.
for _ in 1 2 3 4 5; do
    pgrep -f "/usr/local/stem/stem web" >/dev/null || break
    sleep 1
done

log "Pre-install complete"
exit 0
