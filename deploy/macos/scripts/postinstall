#!/bin/bash
#
# Post-install script for The Stem macOS .pkg
#
# Installs the launchd plists and starts The Stem. The payload carries only
# the binary, the plists and a default config template, so an upgrade leaves
# stem.yaml, auth/, certs/, data/ and .daemon.json (all under
# /usr/local/stem, the daemon's working directory) alone.
#

set -e

INSTALL_DIR="/usr/local/stem"
DAEMON_PLIST="/Library/LaunchDaemons/com.stem.plist"
UPDATE_PLIST="/Library/LaunchDaemons/com.stem.update.plist"

log() {
    /usr/bin/logger -t "stem-installer" "$1"
    echo "$1"
}

log "Starting post-install for The Stem..."

mkdir -p "$INSTALL_DIR/logs"
chmod 700 "$INSTALL_DIR/logs"

# A config left by an earlier install is the operator's.
if [[ ! -e "$INSTALL_DIR/stem.yaml" ]]; then
    install -m 644 "$INSTALL_DIR/configs/stem.yaml" "$INSTALL_DIR/stem.yaml"
fi

chmod 755 "$INSTALL_DIR/stem"
chown -R root:wheel "$INSTALL_DIR"

install -m 644 -o root -g wheel "$INSTALL_DIR/launchd/com.stem.plist" "$DAEMON_PLIST"
# The daily update check exits before any network call until an operator
# turns automatic updates on.
install -m 644 -o root -g wheel "$INSTALL_DIR/launchd/com.stem.update.plist" "$UPDATE_PLIST"

# preinstall booted them out; this covers a package installed straight over a
# daemon that was loaded some other way.
for label in com.stem com.stem.update; do
    launchctl bootout "system/$label" 2>/dev/null || true
done
launchctl bootstrap system "$DAEMON_PLIST"
launchctl bootstrap system "$UPDATE_PLIST"

sleep 3

if pgrep -f "$INSTALL_DIR/stem web" >/dev/null; then
    log "The Stem installation successful - service is running"
else
    log "Warning: service loaded but the process is not running"
    log "Check logs: $INSTALL_DIR/logs/stem.error.log"
fi

log "Post-install complete"
exit 0
