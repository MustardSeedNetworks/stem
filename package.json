{
  "name": "stem",
  "version": "0.1.0",
  "private": true,
  "description": "The Stem - Network Performance Testing - Mustard Seed Networks",
  "type": "module",
  "engines": {
    "node": "26.12.0",
    "npm": "12.2.1"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "cd ui && npm run dev",
    "build": "cd ui && npm run build",
    "preview": "cd ui && npm run preview",
    "lint": "cd ui && npm run lint",
    "lint:fix": "cd ui && npm run lint:fix",
    "format": "cd ui && npm run format",
    "test": "cd ui && npm run test",
    "test:watch": "cd ui && npm run test:watch",
    "test:coverage": "cd ui && npm run test:coverage",
    "test:e2e": "./scripts/run-e2e.sh",
    "storybook": "cd ui && npm run storybook",
    "build-storybook": "cd ui && npm run build-storybook"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "typescript": "7.0.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0"
  },
  "lint-staged": {
    "*.json": "npx --prefix ui biome format --write --config-path ui --no-errors-on-unmatched"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "overrides": {
    "fast-uri": "4.2.3",
    "js-yaml": "5.4.3"
  },
  "packageManager": "npm@12.2.1"
}
